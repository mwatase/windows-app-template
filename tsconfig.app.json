{
  // The interface: everything under src/ plus the test setup. Build tooling
  // and scripts run in Node and are checked by tsconfig.node.json instead, so
  // neither side can accidentally use the other's globals.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],

    "strict": true,
    // An array index or record lookup can be undefined, and saying so is the
    // difference between a type error here and a crash on a customer machine.
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "useDefineForClassFields": true,
    "skipLibCheck": true,
    "noEmit": true,

    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // scripts/starter holds the files `npm run init` puts in place of the demo.
  // Checking them here, with the interface's settings, keeps them compiling.
  "include": ["src", "tests", "scripts/starter"]
}
